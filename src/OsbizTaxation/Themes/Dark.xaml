<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme sombre : palette de couleurs referencee par les styles de Controls.xaml. -->

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="Brush.Window.Foreground" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#FF4A4A50" />
    <SolidColorBrush x:Key="Brush.Control.Hover" Color="#FF3E3E42" />
    <SolidColorBrush x:Key="Brush.Disabled.Foreground" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="Brush.Menu.Background" Color="#FF252526" />
    <SolidColorBrush x:Key="Brush.Menu.Foreground" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="Brush.Menu.Hover" Color="#FF3E3E42" />
    <SolidColorBrush x:Key="Brush.Header.Background" Color="#FF333337" />
    <SolidColorBrush x:Key="Brush.Header.Foreground" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#FF2A5D8F" />
    <SolidColorBrush x:Key="Brush.Selection.Foreground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Grid.Line" Color="#FF3A3A3D" />
    <SolidColorBrush x:Key="Brush.Filter.Icon" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="Brush.Filter.Active" Color="#FF4DA3FF" />
    <SolidColorBrush x:Key="Brush.Input.Background" Color="#FF252526" />

    <!-- Onglets : fond/texte de l'onglet selectionne et texte des onglets non selectionnes. -->
    <SolidColorBrush x:Key="Brush.Tab.Selected.Background" Color="#FF3E3E42" />
    <SolidColorBrush x:Key="Brush.Tab.Selected.Foreground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Tab.Foreground" Color="#FFB0B0B0" />

</ResourceDictionary>
