<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme clair : palette de couleurs referencee par les styles de Controls.xaml. -->

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Window.Foreground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#FFADADAD" />
    <SolidColorBrush x:Key="Brush.Control.Hover" Color="#FFE5F0FA" />
    <SolidColorBrush x:Key="Brush.Disabled.Foreground" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="Brush.Menu.Background" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Brush.Menu.Foreground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.Menu.Hover" Color="#FFD6E8F7" />
    <SolidColorBrush x:Key="Brush.Header.Background" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="Brush.Header.Foreground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#FFCCE4F7" />
    <SolidColorBrush x:Key="Brush.Selection.Foreground" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.Grid.Line" Color="#FFDCDCDC" />
    <SolidColorBrush x:Key="Brush.Filter.Icon" Color="#FF333333" />
    <SolidColorBrush x:Key="Brush.Filter.Active" Color="#FF0B66C3" />
    <SolidColorBrush x:Key="Brush.Input.Background" Color="#FFFFFFFF" />

</ResourceDictionary>
