<Window x:Class="OsbizTaxation.Views.TransfertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Transfert des CDR" Height="560" Width="720"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Window.Foreground}"
        WindowStartupLocation="CenterOwner"
        MinHeight="420" MinWidth="560">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sites &#224; transf&#233;rer" FontWeight="SemiBold" Margin="0,0,0,6" />

        <ListBox Grid.Row="1" x:Name="ListSites" MaxHeight="180"
                 ItemsSource="{Binding Sites}"
                 BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Adresse, StringFormat={}  ({0})}" Foreground="Gray" />
                            <TextBlock Text="{Binding Pays, StringFormat={}  - {0}}" Foreground="Gray" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,6">
            <Button Content="Tout s&#233;lectionner" Padding="10,3" Margin="0,0,8,0" Click="OnToutSelectionnerClick" />
            <Button Content="Tout d&#233;s&#233;lectionner" Padding="10,3" Margin="0,0,8,0" Click="OnToutDeselectionnerClick" />
            <Button Content="Transf&#233;rer maintenant" Padding="16,4" FontWeight="SemiBold"
                    x:Name="BtnTransferer" Click="OnTransfererClick" />
        </StackPanel>

        <GroupBox Grid.Row="3" Header="Journal">
            <TextBox x:Name="TxtJournal"
                     IsReadOnly="True"
                     IsUndoEnabled="False"
                     FontFamily="Consolas" FontSize="12"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto" />
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Fermer" Padding="18,6" Click="OnFermerClick" />
        </StackPanel>
    </Grid>
</Window>
