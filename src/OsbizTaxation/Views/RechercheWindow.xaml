<Window x:Class="OsbizTaxation.Views.RechercheWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Recherche" Height="560" Width="980"
        WindowStartupLocation="CenterOwner"
        MinHeight="420" MinWidth="720">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Site" VerticalAlignment="Center" Margin="0,4,8,4" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmdSite" Margin="0,4,16,4" Padding="4" />

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Num&#233;ro" VerticalAlignment="Center" Margin="0,4,8,4" />
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtNumero" Margin="0,4" Padding="4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Nom ligne" VerticalAlignment="Center" Margin="0,4,8,4" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtNomLigne" Margin="0,4,16,4" Padding="4" />

            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Du" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker x:Name="DpDebut" Width="130" />
                <TextBlock Text="au" VerticalAlignment="Center" Margin="8,0,6,0" />
                <DatePicker x:Name="DpFin" Width="130" />
                <Button Content="Rechercher" Padding="16,4" Margin="12,0,0,0" Click="OnRechercherClick" />
                <Button Content="R&#233;initialiser" Padding="12,4" Margin="8,0,0,0" Click="OnReinitialiserClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,6,0,6">
            <TextBlock x:Name="TxtResultat" Text="Aucune recherche." Foreground="Gray" />
        </Border>

        <DataGrid Grid.Row="2"
                  x:Name="GridResultats"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="80" />
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="90" />
                <DataGridTextColumn Header="Heure D&#233;but" Binding="{Binding HeureDebut}" Width="90" />
                <DataGridTextColumn Header="Heure Fin" Binding="{Binding HeureFin}" Width="90" />
                <DataGridTextColumn Header="Ligne" Binding="{Binding Ligne}" Width="55" />
                <DataGridTextColumn Header="Nom Ligne" Binding="{Binding NomLigne}" Width="110" />
                <DataGridTextColumn Header="N&#176; Interne" Binding="{Binding NumeroInterne}" Width="85" />
                <DataGridTextColumn Header="Dur&#233;e" Binding="{Binding DureeAppel}" Width="75" />
                <DataGridTextColumn Header="Num&#233;ro Externe" Binding="{Binding NumeroExterne}" Width="130" />
                <DataGridTextColumn Header="Information" Binding="{Binding Information}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Fermer" Padding="18,6" Click="OnFermerClick" />
        </StackPanel>
    </Grid>
</Window>
