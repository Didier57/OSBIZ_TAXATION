<Window x:Class="OsbizTaxation.Views.RechercheWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:OsbizTaxation.Helpers"
        mc:Ignorable="d"
        Title="Recherche" Height="560" Width="1120"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Window.Foreground}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinHeight="420" MinWidth="720">
    <Window.Resources>
        <helpers:GroupBrushConverter x:Key="GroupBrush" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="P&#233;riode" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="CmdPeriode" Width="110" Padding="4" VerticalContentAlignment="Center"
                      SelectionChanged="OnPeriodeChanged">
                <ComboBoxItem Content="Jour" />
                <ComboBoxItem Content="Mois" />
                <ComboBoxItem Content="Ann&#233;e" />
            </ComboBox>

            <Button x:Name="BtnPrec" Content="&#9664;" Width="34" Margin="8,0,0,0" Click="OnPrecedentClick" ToolTip="P&#233;riode pr&#233;c&#233;dente" />

            <TextBlock Text="Date" VerticalAlignment="Center" Margin="12,0,8,0" />
            <DatePicker x:Name="DpDate" Width="140" VerticalContentAlignment="Center"
                        SelectedDateChanged="OnDateChanged" />

            <Button x:Name="BtnSuiv" Content="&#9654;" Width="34" Margin="8,0,0,0" Click="OnSuivantClick" ToolTip="P&#233;riode suivante" />

            <Button x:Name="BtnAujourdhui" Content="Aujourd'hui" Padding="10,4" Margin="8,0,0,0"
                    Click="OnAujourdhuiClick" ToolTip="Revenir &#224; la date du jour" />

            <TextBlock Text="S&#233;lectionner le site" VerticalAlignment="Center" Margin="24,0,8,0" />
            <ComboBox x:Name="CmdSite" Width="180" Padding="4" VerticalContentAlignment="Center"
                      SelectionChanged="OnSiteChanged" />

            <Button Content="Supprimer filtres" Padding="12,4" Margin="16,0,0,0" Click="OnSupprimerFiltresClick" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,6,0,6">
            <TextBlock x:Name="TxtResultat" Text="Aucune recherche." Foreground="Gray" />
        </Border>

        <DataGrid Grid.Row="2"
                  x:Name="GridResultats"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="All"
                  EnableRowVirtualization="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding Groupe, Converter={StaticResource GroupBrush}}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="Auto" />
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="90" />
                <DataGridTextColumn Header="Heure D&#233;but" Binding="{Binding HeureDebut}" Width="90" />
                <DataGridTextColumn Header="Heure Fin" Binding="{Binding HeureFin}" Width="90" />
                <DataGridTextColumn Header="Ligne" Binding="{Binding Ligne}" Width="Auto" />
                <DataGridTextColumn Header="Nom Ligne" Binding="{Binding NomLigne}" Width="Auto" />
                <DataGridTextColumn Header="N&#176; Interne" Binding="{Binding NumeroInterne}" Width="Auto" />
                <DataGridTextColumn Header="Dur&#233;e" Binding="{Binding DureeAppel}" Width="75" />
                <DataGridTextColumn Header="Num&#233;ro Externe" Binding="{Binding NumeroExterne}" Width="Auto" />
                <DataGridTextColumn Header="Information" Binding="{Binding Information}" Width="Auto" />
                <DataGridTextColumn Header="Taxes" Binding="{Binding Taxes}" Width="Auto" />
                <DataGridTextColumn Header="Account Code" Binding="{Binding AccountCode}" Width="Auto" />
                <DataGridTextColumn Header="Groupe" Binding="{Binding Groupe}" Width="70" />
                <DataGridTextColumn Header="Pays" Binding="{Binding Pays}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Colonnes…" Padding="18,6" Margin="0,0,8,0" Click="OnColonnesClick"
                    ToolTip="R&#233;ordonner ou masquer les colonnes" />
            <Button Content="Export Excel" Padding="18,6" Margin="0,0,8,0" Click="OnExportExcelClick"
                    ToolTip="Exporter les lignes affich&#233;es (filtres compris) vers Excel" />
            <Button Content="Fermer" Padding="18,6" Click="OnFermerClick" />
        </StackPanel>
    </Grid>
</Window>
