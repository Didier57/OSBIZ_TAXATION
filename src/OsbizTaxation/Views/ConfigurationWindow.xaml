<Window x:Class="OsbizTaxation.Views.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Configuration" Height="560" Width="900"
        WindowStartupLocation="CenterOwner"
        MinHeight="420" MinWidth="720">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Site">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridSites"
                              Grid.Row="0"
                              ItemsSource="{Binding Sites}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="120" />
                            <DataGridTextColumn Header="Adresse (IP / domaine)" Binding="{Binding Adresse}" Width="180" />
                            <DataGridTextColumn Header="Utilisateur" Binding="{Binding Utilisateur}" Width="120" />
                            <DataGridTextColumn Header="Mot de passe" Binding="{Binding MotDePasse}" Width="140" />
                            <DataGridComboBoxColumn x:Name="ColSitePays"
                                                    Header="Pays"
                                                    SelectedValueBinding="{Binding PaysCode}"
                                                    SelectedValuePath="Code"
                                                    DisplayMemberPath="Name"
                                                    Width="170" />
                            <DataGridCheckBoxColumn Header="Suppr. apr&#232;s transfert"
                                                    Binding="{Binding SupprimerApresTransfert}"
                                                    Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Ajouter" Padding="14,4" Margin="0,0,8,0" Click="OnAjouterSiteClick" />
                        <Button Content="Supprimer" Padding="14,4" Click="OnSupprimerSiteClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Lignes">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridLignes"
                              Grid.Row="0"
                              ItemsSource="{Binding Lignes}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Num D&#233;but" Binding="{Binding NumDebut}" Width="90" />
                            <DataGridTextColumn Header="Num Fin" Binding="{Binding NumFin}" Width="90" />
                            <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="140" />
                            <DataGridTextColumn Header="Nom Ligne" Binding="{Binding NomLigne}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Ajouter" Padding="14,4" Margin="0,0,8,0" Click="OnAjouterLigneClick" />
                        <Button Content="Supprimer" Padding="14,4" Margin="0,0,8,0" Click="OnSupprimerLigneClick" />
                        <Button Content="R&#233;attribuer Nom Lignes" Padding="14,4" Click="OnReattribuerClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Options">
                <StackPanel Margin="16">
                    <CheckBox Content="V&#233;rifier les mises &#224; jour au d&#233;marrage"
                              IsChecked="{Binding CheckUpdatesOnStartup}" Margin="0,8" />
                    <CheckBox Content="Activer le transfert automatique"
                              IsChecked="{Binding AutoTransferEnabled}" Margin="0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Intervalle (minutes)" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding AutoTransferIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" Padding="4" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Enregistrer" Padding="18,6" Margin="0,0,8,0" Click="OnEnregistrerClick" />
            <Button Content="Fermer" Padding="18,6" Click="OnFermerClick" />
        </StackPanel>
    </Grid>
</Window>
