<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>OsbizTaxation</RootNamespace>
    <AssemblyName>OsbizTaxation</AssemblyName>

    <Version>1.3.5</Version>
    <FileVersion>1.3.5.0</FileVersion>
    <AssemblyVersion>1.3.5.0</AssemblyVersion>
    <InformationalVersion>1.3.5</InformationalVersion>
    <Product>OSBIZ TAXATION</Product>
    <Company>Didier57</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>


    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <!-- Utilise NLS de Windows (au lieu d'ICU) pour obtenir les noms de pays
       traduits dans la langue du systeme (ici le francais). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

</Project>
