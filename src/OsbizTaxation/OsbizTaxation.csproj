<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OsbizTaxation</RootNamespace>
    <AssemblyName>OsbizTaxation</AssemblyName>

    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>OSBIZ TAXATION</Product>
    <Company>Didier57</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>


    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <!-- L'icone est embarquee comme ressource WPF pour pouvoir la charger via
       pack URI (barre de titre et zone de notification). -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- WinForms est active uniquement pour le menu contextuel de l'icone de la
       zone de notification. On retire ses implicit usings pour eviter les
       conflits (ex : MessageBox ambigu entre System.Windows et
       System.Windows.Forms). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Utilise NLS de Windows (au lieu d'ICU) pour obtenir les noms de pays
       traduits dans la langue du systeme (ici le francais). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

</Project>
