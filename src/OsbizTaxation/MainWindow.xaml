<Window x:Class="OsbizTaxation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:OsbizTaxation.Helpers"
        mc:Ignorable="d"
        Title="Taxation OSBIZ" Height="720" Width="1200"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Window.Foreground}"
        WindowStartupLocation="CenterScreen"
        MinHeight="520" MinWidth="900">
    <Window.Resources>
        <helpers:GroupBrushConverter x:Key="GroupBrush" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Brush.Menu.Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Menu Grid.Column="0" IsMainMenu="True">
                <MenuItem Header="_Fichier">
                    <MenuItem Header="_Quitter" Click="OnQuitClick" />
                </MenuItem>
                <MenuItem Header="_Configuration" Click="OnConfigurationClick" />
                <MenuItem Header="_Transfert" Click="OnTransfertClick" />
                <MenuItem Header="_Recherche" Click="OnRechercheClick" />
                <MenuItem Header="_Statistiques" Click="OnStatistiquesClick" />
                <MenuItem Header="_Import/Export" Click="OnImportExportClick" />
                <MenuItem Header="?" Click="OnAboutClick" />
            </Menu>

            <Button x:Name="BtnTheme"
                    Grid.Column="1"
                    Width="40" Height="24"
                    Margin="0,1,4,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Changer de theme"
                    Click="OnThemeClick">
                <TextBlock x:Name="TxtThemeIcon"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Text="&#xE708;"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>
        </Grid>

        <DataGrid x:Name="GridCdr"
                  Grid.Row="1"
                  Margin="8"
                  ItemsSource="{Binding Records}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  EnableRowVirtualization="True"
                  FrozenColumnCount="1">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding Groupe, Converter={StaticResource GroupBrush}}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="Auto" />
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="90" />
                <DataGridTextColumn Header="Heure D&#233;but" Binding="{Binding HeureDebut}" Width="90" />
                <DataGridTextColumn Header="Heure Fin" Binding="{Binding HeureFin}" Width="90" />
                <DataGridTextColumn Header="Ligne" Binding="{Binding Ligne}" Width="Auto" />
                <DataGridTextColumn Header="Nom Ligne" Binding="{Binding NomLigne}" Width="Auto" />
                <DataGridTextColumn Header="N&#176; Interne" Binding="{Binding NumeroInterne}" Width="Auto" />
                <DataGridTextColumn Header="Dur&#233;e Sonnerie" Binding="{Binding DureeSonnerie}" Width="105" />
                <DataGridTextColumn Header="Dur&#233;e appel" Binding="{Binding DureeAppel}" Width="95" />
                <DataGridTextColumn Header="Num&#233;ro Externe" Binding="{Binding NumeroExterne}" Width="Auto" />
                <DataGridTextColumn Header="Information" Binding="{Binding Information}" Width="Auto" />
                <DataGridTextColumn Header="Num&#233;ro Extra" Binding="{Binding NumeroExtra}" Width="Auto" />
                <DataGridTextColumn Header="Groupe" Binding="{Binding Groupe}" Width="70" />
                <DataGridTextColumn Header="Pays" Binding="{Binding Pays}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding LastTransfer, StringFormat={}Dernier transfert : {0}}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding Version, StringFormat={}Version {0}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
